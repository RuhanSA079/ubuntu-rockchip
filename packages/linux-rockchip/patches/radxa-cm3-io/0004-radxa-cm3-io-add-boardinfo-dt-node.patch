From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ruhan <35257374+RuhanSA079@users.noreply.github.com>
Date: Sat, 5 Sep 2026 00:00:00 +0000
Subject: [PATCH] radxa-cm3-io: add boardinfo devicetree node

Adds the 'boardinfo' node the boardinfo driver (previous patch) looks
up by name, so /proc/boardinfo reports "Radxa CM3 IO" on this board.

---
 arch/arm64/boot/dts/rockchip/rk3566-radxa-cm3-io.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-radxa-cm3-io.dts b/arch/arm64/boot/dts/rockchip/rk3566-radxa-cm3-io.dts
--- a/arch/arm64/boot/dts/rockchip/rk3566-radxa-cm3-io.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-radxa-cm3-io.dts
@@ -14,6 +14,11 @@
 	model = "Radxa CM3 IO";
 	compatible = "radxa,radxa-cm3-io", "rockchip,rk3566";

+	boardinfo {
+		compatible = "custom,boardinfo";
+		boardname = "Radxa CM3 IO";
+	};
+
 	hdmi_sound: hdmi-sound {
 		compatible = "simple-audio-card";
 		simple-audio-card,format = "i2s";
--
2.43.0
